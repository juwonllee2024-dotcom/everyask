{
  "name": "everyask",
  "version": "0.1.0",
  "description": "A local-first Chrome extension that checks whether an AI answered every part of a request.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/collectors.test.mjs test/coverage.test.mjs test/segmenter.test.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20"
  }
}
